# Fixture user config. Relative Include paths resolve against ~/.ssh.
Include conf.d/*.conf
Include loop.conf

Host web1 web2 !web3
    HostName %h.example.com
    User=deploy
    Port 2201

Host web3
    HostName web3.internal

Host "quoted alias"
    HostName 10.0.0.5
    IdentityFile "~/.ssh/key with space"

Host bastion
    hostname bastion.example.com
    USER jump
    ForwardAgent yes

Host db
    HostName 10.1.2.3
    ProxyJump bastion
    LocalForward 5432 localhost:5432
    LocalForward 6379 localhost:6379
    IdentityFile ~/.ssh/db_%r
    Port 2222
    # First obtained value wins.
    Port 3333

Host legacy
    HostName legacy.example.com
    ProxyCommand ssh -W %h:%p bastion

Match host *.example.com user deploy
    ServerAliveInterval 30

Match exec "touch /tmp/termax-interop-must-not-run"
    User hacked

Match originalhost db
    Compression yes

Host *
    User fallback
    IdentityFile ~/.ssh/id_ed25519
    ForwardAgent no
    DynamicForward 1080
    UnknownThing yes
